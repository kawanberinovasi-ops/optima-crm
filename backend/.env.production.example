# Contoh environment variable untuk Laravel Cloud (produksi). Isi di dashboard Cloud > Environment > Variables,
# bukan di file. Nilai rahasia (APP_KEY, client secret, password SMTP) jangan pernah masuk repo.
# Variabel DB_* dan AWS_* diisi otomatis oleh Cloud saat database dan bucket di-attach.

APP_NAME="OPTIMA CRM"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://isi-domain-cloud-kamu.laravel.cloud
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# APP_KEY dibuat Cloud otomatis. Kalau tidak, isi dengan hasil: php artisan key:generate --show

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Sesi (SRS 4.1): 60 menit tidak aktif, maksimal 12 jam sejak login. Cookie hanya lewat HTTPS.
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ABSOLUTE_HOURS=12
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Login SSO Google Workspace (SRS 8.2). Redirect URI di Google Cloud Console:
# https://<domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: batasi ke satu domain Workspace
GOOGLE_HOSTED_DOMAIN=

# Email notifikasi dari akun pengembangan Campus Innovate (SRS 8.2)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Selama tahap awal hanya kirim ke alamat uji. Kosongkan setelah klien setuju email dikirim ke alamat OPTIMA.
OPTIMA_MAIL_ALLOWED_DOMAINS=contoh.test
OPTIMA_MAIL_DAILY_LIMIT=200
OPTIMA_DIGEST_TIME=08:00

# Backup harian aplikasi ke Object Storage (disk s3 dari bucket Cloud), simpan 30 hari
OPTIMA_BACKUP_DISK=s3
OPTIMA_BACKUP_TIME=01:00
OPTIMA_BACKUP_KEEP_DAYS=30
# Backup dienkripsi. Kosong = kunci turunan APP_KEY. Isi dengan `openssl rand -base64 32` untuk kunci terpisah,
# lalu simpan salinannya di luar server dan di luar lokasi backup.
OPTIMA_BACKUP_ENCRYPT=true
OPTIMA_BACKUP_KEY=
